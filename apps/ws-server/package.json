{
  "name": "@liveops/ws-server",
  "version": "0.1.0",
  "private": true,
  "description": "Fake log/metrics generator and WebSocket broadcast server for LiveOps",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
